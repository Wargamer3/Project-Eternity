<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.GUI</RootNamespace>
    <AssemblyName>Project Eternity GUI</AssemblyName>
    <OutputType>WinExe</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\Project Eternity\Project Eternity\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\Editors\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Formula Parser.cs" />
    <Compile Include="Splash Screen.cs" />
    <Compile Include="Splash Screen.Designer.cs" DependentUpon="Splash Screen.cs" />
    <Compile Include="GUI Graphic Device.cs" />
    <Compile Include="Project Eternity GUI.cs" />
    <Compile Include="Project Eternity GUI.Designer.cs" DependentUpon="Project Eternity GUI.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties Form.cs" />
    <Compile Include="Properties Form.Designer.cs" DependentUpon="Properties Form.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project Eternity GUI.resx" DependentUpon="Project Eternity GUI.cs" />
    <EmbeddedResource Include="Properties Form.resx" DependentUpon="Properties Form.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <EmbeddedResource Include="Splash Screen.resx" DependentUpon="Splash Screen.cs" />
  </ItemGroup>

</Project>
