<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.Units.MultiForm</RootNamespace>
    <AssemblyName>Project Eternity Unit Multi-Form</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Units\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\Project Eternity Unit Normal\Project Eternity Unit Normal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Unit Multi-Form.cs" />
  </ItemGroup>

</Project>
