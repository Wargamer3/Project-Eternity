<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.GameScreens.SorcererStreetScreen</RootNamespace>
    <AssemblyName>Project Eternity Sorcerer Street Scripts</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Scripts\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\Project Eternity Sorcerer Street\Project Eternity Sorcerer Street.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DeckSelector.cs" />
    <Compile Include="Cutscene Scripts\Script Spawn Player.cs" />
    <Compile Include="Deck Editor.cs" />
    <Compile Include="Deck Editor.Designer.cs" DependentUpon="Deck Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Sorcerer Street Cutscene Scripts Holder.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Deck Editor.resx" DependentUpon="Deck Editor.cs" />
  </ItemGroup>

</Project>
