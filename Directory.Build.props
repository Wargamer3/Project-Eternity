<Project>
  <!-- Applies only to SDK-style projects. Old net461 csproj files import this file and skip the group. -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- AssemblyInfo.cs is kept, so the SDK does not mark the assembly Windows-only. MonoGame then warns CA1416 on every input call. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!--
      VS 2022 17.8+ copies referenced project DLLs into this project's OutputPath on its own.
      That copy ignores Private=false and runs on Rebuild All. Each project already builds
      straight into the shared bin, so the extra copy is what plants duplicate plugins.
    -->
    <AccelerateBuildsInVisualStudio>false</AccelerateBuildsInVisualStudio>
  </PropertyGroup>
</Project>
