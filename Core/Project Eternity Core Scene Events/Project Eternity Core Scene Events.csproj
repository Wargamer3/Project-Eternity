<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.Scene</RootNamespace>
    <AssemblyName>Project Eternity Core Scene Events</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Scenes\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\Project Eternity Scene\Project Eternity Scene.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Delete All Scene Objects Event.cs" />
    <Compile Include="Goto Event.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Delete Scene Object Event.cs" />
    <Compile Include="Scene Object Timeline.cs" />
    <Compile Include="Timeline Event.cs" />
  </ItemGroup>

</Project>
