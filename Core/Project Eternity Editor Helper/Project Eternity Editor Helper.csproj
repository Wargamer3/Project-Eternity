<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.Editor</RootNamespace>
    <AssemblyName>Project Eternity Editor Helper</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\Project Eternity Graphics\Project Eternity Graphics.csproj" />
  </ItemGroup>

</Project>
