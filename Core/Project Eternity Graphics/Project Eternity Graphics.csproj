<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.Graphics</RootNamespace>
    <AssemblyName>Project Eternity Graphics</AssemblyName>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of the old project compile list. -->
    <Compile Remove="Billboard System\Background System.cs" />
    <Compile Remove="Billboard System\Background Vertex.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Control Helper\Project Eternity Control Helper.csproj" />
  </ItemGroup>

  <!--
    assimp.dll is a native runtime. Core is a managed plugin folder, so the managed wrapper is removed from that output.
    The game host copies AssimpNet.dll to External. This target places the native library beside it.
  -->
  <Target Name="CopyAssimpNative" AfterTargets="Build">
    <ItemGroup>
      <_AssimpNative Include="$(NuGetPackageRoot)assimpnet\4.1.0\runtimes\win-x64\native\assimp.dll" />
    </ItemGroup>
    <Copy Condition="'@(_AssimpNative)' != ''" SourceFiles="@(_AssimpNative)" DestinationFiles="@(_AssimpNative->'$(MSBuildThisFileDirectory)..\..\Project Eternity\Project Eternity\bin\$(Configuration)\External\assimp.dll')" SkipUnchangedFiles="false" />
    <Delete Files="$(OutputPath)AssimpNet.dll" TreatErrorsAsWarnings="true" />
    <Delete Files="$(OutputPath)AssimpNet.pdb" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
