<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.AI</RootNamespace>
    <AssemblyName>Project Eternity AI</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AI.cs" />
    <Compile Include="Core AI.cs" />
    <Compile Include="Following Script Order Editor.cs" />
    <Compile Include="Following Script Order Editor.Designer.cs" DependentUpon="Following Script Order Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Selectors.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Following Script Order Editor.resx" DependentUpon="Following Script Order Editor.cs" />
  </ItemGroup>

</Project>
