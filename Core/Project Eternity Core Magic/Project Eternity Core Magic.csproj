<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.Magic</RootNamespace>
    <AssemblyName>Project Eternity Core Magic</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Magic\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\Project Eternity Constants\Project Eternity Constants.csproj" />
    <ProjectReference Include="..\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\Project Eternity Magic\Project Eternity Magic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Core Magic.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
