<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.GameScreens.AnimationScreen</RootNamespace>
    <AssemblyName>Project Eternity Core Timelines</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Timelines\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\Project Eternity Graphics\Project Eternity Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Damage Timeline.cs" />
    <Compile Include="Lightning Spawner Helper.cs" />
    <Compile Include="Lightning Spawner Helper.Designer.cs" DependentUpon="Lightning Spawner Helper.cs" />
    <Compile Include="Lightning Spawner Viewer.cs" />
    <Compile Include="Lightning Timeline.cs" />
    <Compile Include="Particle Emitter.cs" />
    <Compile Include="Animated Chain Spawner Helper.cs" />
    <Compile Include="Animated Chain Spawner Helper.Designer.cs" DependentUpon="Animated Chain Spawner Helper.cs" />
    <Compile Include="Animated Bitmap Spawner Helper.cs" />
    <Compile Include="Animated Bitmap Spawner Helper.Designer.cs" DependentUpon="Animated Bitmap Spawner Helper.cs" />
    <Compile Include="Animated Bitmap Spawner Viewer.cs" />
    <Compile Include="Animated Chain Timeline.cs" />
    <Compile Include="Animated Tile Timeline.cs" />
    <Compile Include="Animated Bitmap Timeline.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Selectors.cs" />
    <Compile Include="Sprite Sheet Helper.cs" />
    <Compile Include="Sprite Sheet Helper.Designer.cs" DependentUpon="Sprite Sheet Helper.cs" />
    <Compile Include="Sprite Sheet Timeline.cs" />
    <Compile Include="Sprite Sheet Viewer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Animated Chain Spawner Helper.resx" DependentUpon="Animated Chain Spawner Helper.cs" />
    <EmbeddedResource Include="Animated Bitmap Spawner Helper.resx" DependentUpon="Animated Bitmap Spawner Helper.cs" />
    <EmbeddedResource Include="Lightning Spawner Helper.resx" DependentUpon="Lightning Spawner Helper.cs" />
    <EmbeddedResource Include="Sprite Sheet Helper.resx" DependentUpon="Sprite Sheet Helper.cs" />
  </ItemGroup>

</Project>
