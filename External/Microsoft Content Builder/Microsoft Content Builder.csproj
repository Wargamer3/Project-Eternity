<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.Xna.Framework.Content.Builder</RootNamespace>
    <AssemblyName>Microsoft Content Builder</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\External\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dotnet-mgcb" Version="3.8.1.303" GeneratePathProperty="true" ExcludeAssets="all" />
    <Compile Remove="ErrorLogger.cs" />
  </ItemGroup>

  <!--
    External does not copy NuGet files. mgcb has to sit beside this DLL so an editor
    can compile a PNG without depending on the machine's tool cache.
  -->
  <Target Name="CopyMgcbTool" AfterTargets="Build">
    <ItemGroup>
      <_MgcbTool Include="$(Pkgdotnet-mgcb)\tools\net6.0\any\*.*" />
      <_MgcbTool Include="$(Pkgdotnet-mgcb)\tools\net6.0\any\x64\**\*.*" />
      <_MgcbTool Include="$(Pkgdotnet-mgcb)\tools\net6.0\any\runtimes\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MgcbTool)"
          DestinationFiles="@(_MgcbTool->'$(TargetDir)mgcb\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
