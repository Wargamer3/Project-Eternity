<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FMOD</RootNamespace>
    <AssemblyName>FMOD</AssemblyName>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\External\</OutputPath>
    <DefineConstants>$(DefineConstants);WIN64</DefineConstants>
  </PropertyGroup>

  <!-- A CopyToOutputDirectory item is pulled into every project that references FMOD. Startup LoadFile scans those folders. -->
  <Target Name="CopyFmodNative" AfterTargets="Build">
    <Copy SourceFiles="fmodex.dll;fmodex64.dll;fmodexL.dll;fmodexL64.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
