<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Physics</RootNamespace>
    <AssemblyName>Physics</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\External\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BEPUphysics 1 controller and drawers remain in this folder. They do not compile against BepuPhysics 2. -->
    <Compile Include="Properties\AssemblyInfo.cs" />
    <!-- BepuPhysics 2.4.0 character demo: capsule body, support detection, and the motion constraint. -->
    <Compile Include="BepuCharacter\CharacterControllers.cs" />
    <Compile Include="BepuCharacter\CharacterMotionConstraint.cs" />
    <Compile Include="BepuCharacter\CharacterNarrowphaseCallbacks.cs" />
  </ItemGroup>

</Project>
