<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.TripleThunderEditor</RootNamespace>
    <AssemblyName>Project Eternity Triple Thunder Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Triple Thunder\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Online\Project Eternity Online.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Triple Thunder\Project Eternity Triple Thunder.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Map Properties.cs" />
    <Compile Include="Map Properties.Designer.cs" DependentUpon="Map Properties.cs" />
    <Compile Include="Skill Chain Editor.cs" />
    <Compile Include="Skill Chain Editor.Designer.cs" DependentUpon="Skill Chain Editor.cs" />
    <Compile Include="ComboEditor.cs" />
    <Compile Include="ComboEditor.Designer.cs" DependentUpon="ComboEditor.cs" />
    <Compile Include="Layer Viewer.cs" />
    <Compile Include="Project Eternity Triple Thunder Editor.cs" />
    <Compile Include="Project Eternity Triple Thunder Editor.Designer.cs" DependentUpon="Project Eternity Triple Thunder Editor.cs" />
    <Compile Include="Projectile Editor.cs" />
    <Compile Include="Projectile Editor.Designer.cs" DependentUpon="Projectile Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Weapon Editor.cs" />
    <Compile Include="Weapon Editor.Designer.cs" DependentUpon="Weapon Editor.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Map Properties.resx" DependentUpon="Map Properties.cs" />
    <EmbeddedResource Include="Skill Chain Editor.resx" DependentUpon="Skill Chain Editor.cs" />
    <EmbeddedResource Include="ComboEditor.resx" DependentUpon="ComboEditor.cs" />
    <EmbeddedResource Include="Project Eternity Triple Thunder Editor.resx" DependentUpon="Project Eternity Triple Thunder Editor.cs" />
    <EmbeddedResource Include="Projectile Editor.resx" DependentUpon="Projectile Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <EmbeddedResource Include="Weapon Editor.resx" DependentUpon="Weapon Editor.cs" />
  </ItemGroup>

</Project>
