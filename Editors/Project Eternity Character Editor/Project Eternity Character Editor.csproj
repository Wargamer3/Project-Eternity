<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.CharacterEditor</RootNamespace>
    <AssemblyName>Project Eternity Character Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Deathmatch\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Character Quotes Editor.cs" />
    <Compile Include="Character Quotes Editor.Designer.cs" DependentUpon="Character Quotes Editor.cs" />
    <Compile Include="Details Editor.cs" />
    <Compile Include="Details Editor.Designer.cs" DependentUpon="Details Editor.cs" />
    <Compile Include="Relationship Editor.cs" />
    <Compile Include="Relationship Editor.Designer.cs" DependentUpon="Relationship Editor.cs" />
    <Compile Include="Skill Levels Editor.cs" />
    <Compile Include="Skill Levels Editor.Designer.cs" DependentUpon="Skill Levels Editor.cs" />
    <Compile Include="Character Stats Editor.cs" />
    <Compile Include="Character Stats Editor.Designer.cs" DependentUpon="Character Stats Editor.cs" />
    <Compile Include="Project Eternity Character Editor.cs" />
    <Compile Include="Project Eternity Character Editor.Designer.cs" DependentUpon="Project Eternity Character Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Personality Editor.cs" />
    <Compile Include="Personality Editor.Designer.cs" DependentUpon="Personality Editor.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Character Quotes Editor.resx" DependentUpon="Character Quotes Editor.cs" />
    <EmbeddedResource Include="Details Editor.resx" DependentUpon="Details Editor.cs" />
    <EmbeddedResource Include="Relationship Editor.resx" DependentUpon="Relationship Editor.cs" />
    <EmbeddedResource Include="Skill Levels Editor.resx" DependentUpon="Skill Levels Editor.cs" />
    <EmbeddedResource Include="Character Stats Editor.resx" DependentUpon="Character Stats Editor.cs" />
    <EmbeddedResource Include="Project Eternity Character Editor.resx" DependentUpon="Project Eternity Character Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <EmbeddedResource Include="Personality Editor.resx" DependentUpon="Personality Editor.cs" />
  </ItemGroup>

</Project>
