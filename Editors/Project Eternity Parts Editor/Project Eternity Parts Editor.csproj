<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.PartsEditor</RootNamespace>
    <AssemblyName>Project Eternity Parts Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Deathmatch\Units\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Core Effects\Project Eternity Core Effects.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Battle Map Effects\Project Eternity Battle Map Effects.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Consumable Parts Editor.cs" />
    <Compile Include="Consumable Parts Editor.Designer.cs" DependentUpon="Consumable Parts Editor.cs" />
    <Compile Include="Standard Parts Editor.cs" />
    <Compile Include="Standard Parts Editor.Designer.cs" DependentUpon="Standard Parts Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Consumable Parts Editor.resx" DependentUpon="Consumable Parts Editor.cs" />
    <EmbeddedResource Include="Standard Parts Editor.resx" DependentUpon="Standard Parts Editor.cs" />
  </ItemGroup>

</Project>
