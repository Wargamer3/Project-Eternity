<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.UnitTripleThunderEditor</RootNamespace>
    <AssemblyName>Project Eternity Unit Triple Thunder Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Triple Thunder\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Unit Sounds.cs" />
    <Compile Include="Unit Sounds.Designer.cs" DependentUpon="Unit Sounds.cs" />
    <Compile Include="Unit Vehicule Triple Thunder Editor.cs" />
    <Compile Include="Unit Vehicule Triple Thunder Editor.Designer.cs" DependentUpon="Unit Vehicule Triple Thunder Editor.cs" />
    <Compile Include="Unit Triple Thunder Editor.cs" />
    <Compile Include="Unit Triple Thunder Editor.Designer.cs" DependentUpon="Unit Triple Thunder Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Unit Sounds.resx" DependentUpon="Unit Sounds.cs" />
    <EmbeddedResource Include="Unit Vehicule Triple Thunder Editor.resx" DependentUpon="Unit Vehicule Triple Thunder Editor.cs" />
    <EmbeddedResource Include="Unit Triple Thunder Editor.resx" DependentUpon="Unit Triple Thunder Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

</Project>
