<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.ConquestMapEditor</RootNamespace>
    <AssemblyName>Project Eternity Conquest Map Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Conquest\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\External\Microsoft Content Builder\Microsoft Content Builder.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Conquest Map\Project Eternity Conquest Map.csproj" />
    <ProjectReference Include="..\..\Units\Project Eternity Unit Conquest\Project Eternity Unit Conquest.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Map Editor\Project Eternity Map Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Project Eternity Conquest DestroyableTile Editor.cs" />
    <Compile Include="Project Eternity Conquest DestroyableTile Editor.Designer.cs" DependentUpon="Project Eternity Conquest DestroyableTile Editor.cs" />
    <Compile Include="Project Eternity Conquest Terrains and Move Types Editor.cs" />
    <Compile Include="Project Eternity Conquest Terrains and Move Types Editor.Designer.cs" DependentUpon="Project Eternity Conquest Terrains and Move Types Editor.cs" />
    <Compile Include="Project Eternity Conquest Autotile Tileset Editor.cs" />
    <Compile Include="Project Eternity Conquest Autotile Tileset Editor.Designer.cs" DependentUpon="Project Eternity Conquest Autotile Tileset Editor.cs" />
    <Compile Include="Project Eternity Conquest Tileset Editor.cs" />
    <Compile Include="Project Eternity Conquest Tileset Editor.Designer.cs" DependentUpon="Project Eternity Conquest Tileset Editor.cs" />
    <Compile Include="Tabs\Buildings Tab.cs" />
    <Compile Include="Tabs\Scenery Tab.cs" />
    <Compile Include="Tabs\Spawns Tab.cs" />
    <Compile Include="Tabs\Units Tab.cs" />
    <Compile Include="Map Statistics.cs" />
    <Compile Include="Map Statistics.Designer.cs" DependentUpon="Map Statistics.cs" />
    <Compile Include="Project Eternity Conquest Map Editor.cs" />
    <Compile Include="Project Eternity Conquest Map Editor.Designer.cs" DependentUpon="Project Eternity Conquest Map Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Tile Attributes.cs" />
    <Compile Include="Tile Attributes.Designer.cs" DependentUpon="Tile Attributes.cs" />
    <Compile Include="Tabs\Tileset Tab.cs" />
    <Compile Include="Tabs\Extra Tabs.cs" />
    <Compile Include="Tabs\Extra Tabs.Designer.cs" DependentUpon="Extra Tabs.cs" />
    <Compile Include="Building Editor.cs" />
    <Compile Include="Building Editor.Designer.cs" DependentUpon="Building Editor.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project Eternity Conquest DestroyableTile Editor.resx" DependentUpon="Project Eternity Conquest DestroyableTile Editor.cs" />
    <EmbeddedResource Include="Project Eternity Conquest Terrains and Move Types Editor.resx" DependentUpon="Project Eternity Conquest Terrains and Move Types Editor.cs" />
    <EmbeddedResource Include="Map Statistics.resx" DependentUpon="Map Statistics.cs" />
    <EmbeddedResource Include="Project Eternity Conquest Map Editor.resx" DependentUpon="Project Eternity Conquest Map Editor.cs" />
    <EmbeddedResource Include="Project Eternity Conquest Autotile Tileset Editor.resx" DependentUpon="Project Eternity Conquest Autotile Tileset Editor.cs" />
    <EmbeddedResource Include="Project Eternity Conquest Tileset Editor.resx" DependentUpon="Project Eternity Conquest Tileset Editor.cs" />
    <EmbeddedResource Include="Tile Attributes.resx" DependentUpon="Tile Attributes.cs" />
    <EmbeddedResource Include="Tabs\Extra Tabs.resx" DependentUpon="Extra Tabs.cs" />
    <EmbeddedResource Include="Building Editor.resx" DependentUpon="Building Editor.cs" />
  </ItemGroup>

</Project>
