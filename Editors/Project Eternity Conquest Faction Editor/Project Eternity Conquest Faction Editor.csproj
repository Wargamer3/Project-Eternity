<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.ConquestFactionEditor</RootNamespace>
    <AssemblyName>Project Eternity Conquest Faction Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Conquest\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Faction Editor.cs" />
    <Compile Include="Faction Editor.Designer.cs" DependentUpon="Faction Editor.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\Resources.resx" />
    <EmbeddedResource Include="Faction Editor.resx" DependentUpon="Faction Editor.cs" />
  </ItemGroup>

</Project>
