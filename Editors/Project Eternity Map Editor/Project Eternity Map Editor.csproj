<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.MapEditor</RootNamespace>
    <AssemblyName>Project Eternity Map Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Control Helper\Project Eternity Control Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\External\Microsoft Content Builder\Microsoft Content Builder.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
    <ProjectReference Include="..\Project Eternity Music Player\Project Eternity Music Player.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Default Game Modes Conditions.cs" />
    <Compile Include="Default Game Modes Conditions.Designer.cs" DependentUpon="Default Game Modes Conditions.cs" />
    <Compile Include="Map Statistics.cs" />
    <Compile Include="Map Statistics.Designer.cs" DependentUpon="Map Statistics.cs" />
    <Compile Include="Project Eternity Destroyable Tile Editor.cs" />
    <Compile Include="Project Eternity Destroyable Tile Editor.Designer.cs" DependentUpon="Project Eternity Destroyable Tile Editor.cs" />
    <Compile Include="Project Eternity Map Editor.cs" />
    <Compile Include="Project Eternity Map Editor.Designer.cs" DependentUpon="Project Eternity Map Editor.cs" />
    <Compile Include="Project Eternity Autotile Tileset Preset Editor.cs" />
    <Compile Include="Project Eternity Autotile Tileset Preset Editor.Designer.cs" DependentUpon="Project Eternity Autotile Tileset Preset Editor.cs" />
    <Compile Include="Project Eternity Tileset Preset Editor.cs" />
    <Compile Include="Project Eternity Tileset Preset Editor.Designer.cs" DependentUpon="Project Eternity Tileset Preset Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
    <Compile Include="UnsafeBitmap.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Default Game Modes Conditions.resx" DependentUpon="Default Game Modes Conditions.cs" />
    <EmbeddedResource Include="Map Statistics.resx" DependentUpon="Map Statistics.cs" />
    <EmbeddedResource Include="Project Eternity Destroyable Tile Editor.resx" DependentUpon="Project Eternity Destroyable Tile Editor.cs" />
    <EmbeddedResource Include="Project Eternity Map Editor.resx" DependentUpon="Project Eternity Map Editor.cs" />
    <EmbeddedResource Include="Project Eternity Autotile Tileset Preset Editor.resx" DependentUpon="Project Eternity Autotile Tileset Preset Editor.cs" />
    <EmbeddedResource Include="Project Eternity Tileset Preset Editor.resx" DependentUpon="Project Eternity Tileset Preset Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

</Project>
