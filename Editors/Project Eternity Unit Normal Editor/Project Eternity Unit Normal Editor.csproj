<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.UnitNormalEditor</RootNamespace>
    <AssemblyName>Project Eternity Unit Normal Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Deathmatch\Units\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\Units\Project Eternity Unit Normal\Project Eternity Unit Normal.csproj" />
    <ProjectReference Include="..\Project Eternity Attack Editor\Project Eternity Attack Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Details Editor.cs" />
    <Compile Include="Details Editor.Designer.cs" DependentUpon="Details Editor.cs" />
    <Compile Include="Unit Size Editor.cs" />
    <Compile Include="Unit Size Editor.Designer.cs" DependentUpon="Unit Size Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Unit Normal Editor.cs" />
    <Compile Include="Unit Normal Editor.Designer.cs" DependentUpon="Unit Normal Editor.cs" />
    <Compile Include="Attacks.cs" />
    <Compile Include="Attacks.Designer.cs" DependentUpon="Attacks.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Details Editor.resx" DependentUpon="Details Editor.cs" />
    <EmbeddedResource Include="Unit Size Editor.resx" DependentUpon="Unit Size Editor.cs" />
    <EmbeddedResource Include="Unit Normal Editor.resx" DependentUpon="Unit Normal Editor.cs" />
    <EmbeddedResource Include="Attacks.resx" DependentUpon="Attacks.cs" />
  </ItemGroup>

</Project>
