<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.AnimationBackgroundEditor</RootNamespace>
    <AssemblyName>Project Eternity Animation Background Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Animation Background Viewer 2D.cs" />
    <Compile Include="Animation Background Viewer.cs" />
    <Compile Include="Animation Background Object 2D Editor.cs" />
    <Compile Include="Animation Background Object 2D Editor.Designer.cs" DependentUpon="Animation Background Object 2D Editor.cs" />
    <Compile Include="Project Eternity Animation Background Editor 2D.cs" />
    <Compile Include="Project Eternity Animation Background Editor 2D.Designer.cs" DependentUpon="Project Eternity Animation Background Editor 2D.cs" />
    <Compile Include="Project Eternity Animation Background Editor.cs" />
    <Compile Include="Project Eternity Animation Background Editor.Designer.cs" DependentUpon="Project Eternity Animation Background Editor.cs" />
    <Compile Include="Properties.cs" />
    <Compile Include="Properties.Designer.cs" DependentUpon="Properties.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Animation Background Object 2D Editor.resx" DependentUpon="Animation Background Object 2D Editor.cs" />
    <EmbeddedResource Include="Project Eternity Animation Background Editor 2D.resx" DependentUpon="Project Eternity Animation Background Editor 2D.cs" />
    <EmbeddedResource Include="Project Eternity Animation Background Editor.resx" DependentUpon="Project Eternity Animation Background Editor.cs" />
    <EmbeddedResource Include="Properties.resx" DependentUpon="Properties.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

</Project>
