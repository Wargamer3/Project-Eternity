<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.DeathmatchMapEditor</RootNamespace>
    <AssemblyName>Project Eternity Deathmatch Map Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Deathmatch\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\..\Mods\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\..\..\Mods\Project Eternity Deathmatch Map\Project Eternity Deathmatch Map.csproj" />
    <ProjectReference Include="..\..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\..\Project Eternity Map Editor\Project Eternity Map Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Deathmatch Map Helper.cs" />
    <Compile Include="Project Eternity Deathmatch Autotile Tileset Editor.cs" />
    <Compile Include="Project Eternity Deathmatch Autotile Tileset Editor.Designer.cs" DependentUpon="Project Eternity Deathmatch Autotile Tileset Editor.cs" />
    <Compile Include="Project Eternity Deathmatch DestroyableTile Editor.cs" />
    <Compile Include="Project Eternity Deathmatch DestroyableTile Editor.Designer.cs" DependentUpon="Project Eternity Deathmatch DestroyableTile Editor.cs" />
    <Compile Include="Project Eternity Deathmatch Tileset Editor.cs" />
    <Compile Include="Project Eternity Deathmatch Tileset Editor.Designer.cs" DependentUpon="Project Eternity Deathmatch Tileset Editor.cs" />
    <Compile Include="Project Eternity Deathmatch Map Editor.cs" />
    <Compile Include="Project Eternity Deathmatch Map Editor.Designer.cs" DependentUpon="Project Eternity Deathmatch Map Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project Eternity Deathmatch Autotile Tileset Editor.resx" DependentUpon="Project Eternity Deathmatch Autotile Tileset Editor.cs" />
    <EmbeddedResource Include="Project Eternity Deathmatch DestroyableTile Editor.resx" DependentUpon="Project Eternity Deathmatch DestroyableTile Editor.cs" />
    <EmbeddedResource Include="Project Eternity Deathmatch Tileset Editor.resx" DependentUpon="Project Eternity Deathmatch Tileset Editor.cs" />
    <EmbeddedResource Include="Project Eternity Deathmatch Map Editor.resx" DependentUpon="Project Eternity Deathmatch Map Editor.cs" />
  </ItemGroup>

</Project>
