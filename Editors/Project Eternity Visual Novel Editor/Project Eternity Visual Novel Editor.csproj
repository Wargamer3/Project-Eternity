<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.VisualNovelEditor</RootNamespace>
    <AssemblyName>Project Eternity Visual Novel Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Visual Novel\Project Eternity Visual Novel.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Add Character ID.cs" />
    <Compile Include="Add Character ID.Designer.cs" DependentUpon="Add Character ID.cs" />
    <Compile Include="Add Character Location.cs" />
    <Compile Include="Add Character Location.Designer.cs" DependentUpon="Add Character Location.cs" />
    <Compile Include="Character Data.cs" />
    <Compile Include="Character Data.Designer.cs" DependentUpon="Character Data.cs" />
    <Compile Include="Dialog Editor.cs" />
    <Compile Include="Dialog Editor.Designer.cs" DependentUpon="Dialog Editor.cs" />
    <Compile Include="Project Eternity Visual Novel Editor.cs" />
    <Compile Include="Project Eternity Visual Novel Editor.Designer.cs" DependentUpon="Project Eternity Visual Novel Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Flowchart Editor.cs" />
    <Compile Include="Flowchart Editor.Designer.cs" DependentUpon="Flowchart Editor.cs" />
    <Compile Include="TextEdit.cs" />
    <Compile Include="TextEdit.Designer.cs" DependentUpon="TextEdit.cs" />
    <Compile Include="Visual Novel Extension.cs" />
    <Compile Include="Visual Novel Viewer.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Add Character ID.resx" DependentUpon="Add Character ID.cs" />
    <EmbeddedResource Include="Add Character Location.resx" DependentUpon="Add Character Location.cs" />
    <EmbeddedResource Include="Character Data.resx" DependentUpon="Character Data.cs" />
    <EmbeddedResource Include="Dialog Editor.resx" DependentUpon="Dialog Editor.cs" />
    <EmbeddedResource Include="Project Eternity Visual Novel Editor.resx" DependentUpon="Project Eternity Visual Novel Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <EmbeddedResource Include="Flowchart Editor.resx" DependentUpon="Flowchart Editor.cs" />
    <EmbeddedResource Include="TextEdit.resx" DependentUpon="TextEdit.cs" />
    <EmbeddedResource Include="Visual Novel Viewer.resx" DependentUpon="Visual Novel Viewer.cs" />
  </ItemGroup>

</Project>
