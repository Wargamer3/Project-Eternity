<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.AttackEditor</RootNamespace>
    <AssemblyName>Project Eternity Attack Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Deathmatch\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\External\Roslyn\Roslyn.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Advanced Settings Editor.cs" />
    <Compile Include="Advanced Settings Editor.Designer.cs" DependentUpon="Advanced Settings Editor.cs" />
    <Compile Include="Attack Formula Editor.cs" />
    <Compile Include="Attack Formula Editor.Designer.cs" DependentUpon="Attack Formula Editor.cs" />
    <Compile Include="All Editor.cs" />
    <Compile Include="All Editor.Designer.cs" DependentUpon="All Editor.cs" />
    <Compile Include="Dash Editor.cs" />
    <Compile Include="Dash Editor.Designer.cs" DependentUpon="Dash Editor.cs" />
    <Compile Include="Destructible Tile Type Picker.cs" />
    <Compile Include="Destructible Tile Type Picker.Designer.cs" DependentUpon="Destructible Tile Type Picker.cs" />
    <Compile Include="Destructible Tiles.cs" />
    <Compile Include="Destructible Tiles.Designer.cs" DependentUpon="Destructible Tiles.cs" />
    <Compile Include="MAP Attack Editor.cs" />
    <Compile Include="MAP Attack Editor.Designer.cs" DependentUpon="MAP Attack Editor.cs" />
    <Compile Include="Knockback Editor.cs" />
    <Compile Include="Knockback Editor.Designer.cs" DependentUpon="Knockback Editor.cs" />
    <Compile Include="PER Attack Editor.cs" />
    <Compile Include="PER Attack Editor.Designer.cs" DependentUpon="PER Attack Editor.cs" />
    <Compile Include="Project Eternity Attack Editor.cs" />
    <Compile Include="Project Eternity Attack Editor.Designer.cs" DependentUpon="Project Eternity Attack Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Quote Editor.cs" />
    <Compile Include="Quote Editor.Designer.cs" DependentUpon="Quote Editor.cs" />
    <Compile Include="Skill Chain Editor.cs" />
    <Compile Include="Skill Chain Editor.Designer.cs" DependentUpon="Skill Chain Editor.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Advanced Settings Editor.resx" DependentUpon="Advanced Settings Editor.cs" />
    <EmbeddedResource Include="Attack Formula Editor.resx" DependentUpon="Attack Formula Editor.cs" />
    <EmbeddedResource Include="All Editor.resx" DependentUpon="All Editor.cs" />
    <EmbeddedResource Include="Dash Editor.resx" DependentUpon="Dash Editor.cs" />
    <EmbeddedResource Include="Destructible Tile Type Picker.resx" DependentUpon="Destructible Tile Type Picker.cs" />
    <EmbeddedResource Include="Destructible Tiles.resx" DependentUpon="Destructible Tiles.cs" />
    <EmbeddedResource Include="MAP Attack Editor.resx" DependentUpon="MAP Attack Editor.cs" />
    <EmbeddedResource Include="Knockback Editor.resx" DependentUpon="Knockback Editor.cs" />
    <EmbeddedResource Include="PER Attack Editor.resx" DependentUpon="PER Attack Editor.cs" />
    <EmbeddedResource Include="Project Eternity Attack Editor.resx" DependentUpon="Project Eternity Attack Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <EmbeddedResource Include="Quote Editor.resx" DependentUpon="Quote Editor.cs" />
    <EmbeddedResource Include="Skill Chain Editor.resx" DependentUpon="Skill Chain Editor.cs" />
  </ItemGroup>

</Project>
