<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.LifeSimCharacterEditor</RootNamespace>
    <AssemblyName>Project Eternity Life Sim Character Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Life Sim\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\..\Mods\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\..\..\Mods\Project Eternity Life Sim\Project Eternity Life Sim.csproj" />
    <ProjectReference Include="..\..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
    <ProjectReference Include="..\..\Project Eternity Map Editor\Project Eternity Map Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Batch Quote Form.cs" />
    <Compile Include="Batch Quote Form.Designer.cs" DependentUpon="Batch Quote Form.cs" />
    <Compile Include="Character Editor.cs" />
    <Compile Include="Character Editor.Designer.cs" DependentUpon="Character Editor.cs" />
    <Compile Include="Character Details Editor.cs" />
    <Compile Include="Character Details Editor.Designer.cs" DependentUpon="Character Details Editor.cs" />
    <Compile Include="Character Quotes Editor.cs" />
    <Compile Include="Character Quotes Editor.Designer.cs" DependentUpon="Character Quotes Editor.cs" />
    <Compile Include="Character Relationship Editor.cs" />
    <Compile Include="Character Relationship Editor.Designer.cs" DependentUpon="Character Relationship Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Batch Quote Form.resx" DependentUpon="Batch Quote Form.cs" />
    <EmbeddedResource Include="Character Editor.resx" DependentUpon="Character Editor.cs" />
    <EmbeddedResource Include="Character Details Editor.resx" DependentUpon="Character Details Editor.cs" />
    <EmbeddedResource Include="Character Quotes Editor.resx" DependentUpon="Character Quotes Editor.cs" />
    <EmbeddedResource Include="Character Relationship Editor.resx" DependentUpon="Character Relationship Editor.cs" />
  </ItemGroup>

</Project>
