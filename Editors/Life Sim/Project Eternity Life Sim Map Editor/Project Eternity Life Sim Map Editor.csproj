<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.LifeSimMapEditor</RootNamespace>
    <AssemblyName>Project Eternity Life Sim Map Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Life Sim\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Project Eternity Animation Screen\Project Eternity Animation Screen.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\..\Mods\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\..\..\Mods\Project Eternity Life Sim\Project Eternity Life Sim.csproj" />
    <ProjectReference Include="..\..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
    <ProjectReference Include="..\..\Project Eternity Image Viewer\Project Eternity Image Viewer.csproj" />
    <ProjectReference Include="..\..\Project Eternity Map Editor\Project Eternity Map Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Project Eternity Life Sim Autotile Tileset Editor.cs" />
    <Compile Include="Project Eternity Life Sim Autotile Tileset Editor.Designer.cs" DependentUpon="Project Eternity Life Sim Autotile Tileset Editor.cs" />
    <Compile Include="Project Eternity Life Sim DestroyableTile Editor.cs" />
    <Compile Include="Project Eternity Life Sim DestroyableTile Editor.Designer.cs" DependentUpon="Project Eternity Life Sim DestroyableTile Editor.cs" />
    <Compile Include="Project Eternity Life Sim Terrains Editor.cs" />
    <Compile Include="Project Eternity Life Sim Terrains Editor.Designer.cs" DependentUpon="Project Eternity Life Sim Terrains Editor.cs" />
    <Compile Include="Project Eternity Life Sim Tileset Editor.cs" />
    <Compile Include="Project Eternity Life Sim Tileset Editor.Designer.cs" DependentUpon="Project Eternity Life Sim Tileset Editor.cs" />
    <Compile Include="Map Statistics.cs" />
    <Compile Include="Map Statistics.Designer.cs" DependentUpon="Map Statistics.cs" />
    <Compile Include="Project Eternity Life Sim Map Editor.cs" />
    <Compile Include="Project Eternity Life Sim Map Editor.Designer.cs" DependentUpon="Project Eternity Life Sim Map Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Tabs\Extra Tabs.cs" />
    <Compile Include="Tabs\Extra Tabs.Designer.cs" DependentUpon="Extra Tabs.cs" />
    <Compile Include="Tabs\Scenery Tab.cs" />
    <Compile Include="Tabs\Tileset Tab.cs" />
    <Compile Include="Tile Attributes.cs" />
    <Compile Include="Tile Attributes.Designer.cs" DependentUpon="Tile Attributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project Eternity Life Sim Autotile Tileset Editor.resx" DependentUpon="Project Eternity Life Sim Autotile Tileset Editor.cs" />
    <EmbeddedResource Include="Project Eternity Life Sim DestroyableTile Editor.resx" DependentUpon="Project Eternity Life Sim DestroyableTile Editor.cs" />
    <EmbeddedResource Include="Project Eternity Life Sim Terrains Editor.resx" DependentUpon="Project Eternity Life Sim Terrains Editor.cs" />
    <EmbeddedResource Include="Project Eternity Life Sim Tileset Editor.resx" DependentUpon="Project Eternity Life Sim Tileset Editor.cs" />
    <EmbeddedResource Include="Map Statistics.resx" DependentUpon="Map Statistics.cs" />
    <EmbeddedResource Include="Project Eternity Life Sim Map Editor.resx" DependentUpon="Project Eternity Life Sim Map Editor.cs" />
    <EmbeddedResource Include="Tabs\Extra Tabs.resx" DependentUpon="Extra Tabs.cs" />
    <EmbeddedResource Include="Tile Attributes.resx" DependentUpon="Tile Attributes.cs" />
  </ItemGroup>

</Project>
