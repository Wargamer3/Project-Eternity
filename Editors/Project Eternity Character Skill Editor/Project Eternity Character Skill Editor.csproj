<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.CharacterSkillEditor</RootNamespace>
    <AssemblyName>Project Eternity Character Skill Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Deathmatch\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Core Effects\Project Eternity Core Effects.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Project Eternity Character Skill Editor.cs" />
    <Compile Include="Project Eternity Character Skill Editor.Designer.cs" DependentUpon="Project Eternity Character Skill Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project Eternity Character Skill Editor.resx" DependentUpon="Project Eternity Character Skill Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

</Project>
