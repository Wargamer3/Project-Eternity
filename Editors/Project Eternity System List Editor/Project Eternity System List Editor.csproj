<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.SystemListEditor</RootNamespace>
    <AssemblyName>Project Eternity System List Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors Standalone\Deathmatch\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="System List Editor.cs" />
    <Compile Include="System List Editor.Designer.cs" DependentUpon="System List Editor.cs" />
    <Compile Include="Terrain and Unit Types Editor.cs" />
    <Compile Include="Terrain and Unit Types Editor.Designer.cs" DependentUpon="Terrain and Unit Types Editor.cs" />
    <Compile Include="Variables List Editor.cs" />
    <Compile Include="Variables List Editor.Designer.cs" DependentUpon="Variables List Editor.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="System List Editor.resx" DependentUpon="System List Editor.cs" />
    <EmbeddedResource Include="Terrain and Unit Types Editor.resx" DependentUpon="Terrain and Unit Types Editor.cs" />
    <EmbeddedResource Include="Variables List Editor.resx" DependentUpon="Variables List Editor.cs" />
  </ItemGroup>

</Project>
