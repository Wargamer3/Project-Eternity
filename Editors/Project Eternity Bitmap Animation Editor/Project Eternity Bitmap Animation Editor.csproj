<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Editors.BitmapAnimationEditor</RootNamespace>
    <AssemblyName>Project Eternity Bitmap Animation Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project Eternity Base Editor\Project Eternity Base Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Project Eternity Bitmap Animation Editor.cs" />
    <Compile Include="Project Eternity Bitmap Animation Editor.Designer.cs" DependentUpon="Project Eternity Bitmap Animation Editor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" DependentUpon="Resources.resx" />
    <Compile Include="Properties\Settings.Designer.cs" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project Eternity Bitmap Animation Editor.resx" DependentUpon="Project Eternity Bitmap Animation Editor.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

</Project>
