<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity.Core.Editor</RootNamespace>
    <AssemblyName>Project Eternity Base Editor</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\Project Eternity\Project Eternity\bin\$(Configuration)\Editors\Core\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>..\..\packages\Microsoft.CodeAnalysis.Common.1.2.2\lib\net45\Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>..\..\packages\Microsoft.CodeAnalysis.CSharp.1.2.2\lib\net45\Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Scripting"><HintPath>..\..\packages\Microsoft.CodeAnalysis.CSharp.Scripting.1.2.2\lib\dotnet\Microsoft.CodeAnalysis.CSharp.Scripting.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.Scripting"><HintPath>..\..\packages\Microsoft.CodeAnalysis.Scripting.Common.1.2.2\lib\dotnet\Microsoft.CodeAnalysis.Scripting.dll</HintPath></Reference>
    <Reference Include="System.AppContext"><HintPath>..\..\packages\System.AppContext.4.0.0\lib\net46\System.AppContext.dll</HintPath></Reference>
    <Reference Include="System.Collections.Immutable"><HintPath>..\..\packages\System.Collections.Immutable.1.1.37\lib\dotnet\System.Collections.Immutable.dll</HintPath></Reference>
    <Reference Include="System.Diagnostics.StackTrace"><HintPath>..\..\packages\System.Diagnostics.StackTrace.4.0.0\lib\net46\System.Diagnostics.StackTrace.dll</HintPath></Reference>
    <Reference Include="System.IO.FileSystem"><HintPath>..\..\packages\System.IO.FileSystem.4.0.0\lib\net46\System.IO.FileSystem.dll</HintPath></Reference>
    <Reference Include="System.IO.FileSystem.Primitives"><HintPath>..\..\packages\System.IO.FileSystem.Primitives.4.0.0\lib\net46\System.IO.FileSystem.Primitives.dll</HintPath></Reference>
    <Reference Include="System.Reflection.Metadata"><HintPath>..\..\packages\System.Reflection.Metadata.1.2.0\lib\portable-net45+win8\System.Reflection.Metadata.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Cutscene\Project Eternity Cutscene.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Editor Helper\Project Eternity Editor Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Base Editor.cs" />
    <Compile Include="Base Editor.Designer.cs" DependentUpon="Base Editor.cs" />
    <Compile Include="CutsceneViewer.cs" />
    <Compile Include="CutsceneViewer.Designer.cs" DependentUpon="CutsceneViewer.cs" />
    <Compile Include="EditorInfo.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Route Editor.cs" />
    <Compile Include="Route Editor.Designer.cs" DependentUpon="Route Editor.cs" />
    <Compile Include="Scene 3D Viewer.cs" />
    <Compile Include="Skill Chain Editor.cs" />
    <Compile Include="Skill Chain Editor.Designer.cs" DependentUpon="Skill Chain Editor.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Base Editor.resx" DependentUpon="Base Editor.cs" />
    <EmbeddedResource Include="CutsceneViewer.resx" DependentUpon="CutsceneViewer.cs" />
    <EmbeddedResource Include="Route Editor.resx" DependentUpon="Route Editor.cs" />
    <EmbeddedResource Include="Skill Chain Editor.resx" DependentUpon="Skill Chain Editor.cs" />
  </ItemGroup>

</Project>
