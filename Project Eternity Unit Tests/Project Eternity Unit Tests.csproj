    <AssemblyName>Project Eternity Unit Tests</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- This folder must not end in \bin\Debug. Directory.Build.targets treats that path as a game host. -->
    <OutputPath>bin\test\$(Configuration)\</OutputPath>
    <!-- Written by WriteTestRunSettings. Absolute, because a relative WorkingDirectory is resolved from the shell, not this file. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\obj\test.runsettings</RunSettingsFilePath>
    <VSTestSetting>$(MSBuildProjectDirectory)\obj\test.runsettings</VSTestSetting>
  </PropertyGroup>

