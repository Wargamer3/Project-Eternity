  <Target Name="WriteTestRunSettings" BeforeTargets="VSTest">
    <PropertyGroup>
      <_TestGameBin>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Project Eternity\Project Eternity\bin\$(Configuration)'))</_TestGameBin>
      <_TestRunSettingsPath>$(MSBuildProjectDirectory)\obj\test.runsettings</_TestRunSettingsPath>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj" />
    <ItemGroup>
      <_TestRunSettingsLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <_TestRunSettingsLine Include="&lt;RunSettings&gt;" />
      <_TestRunSettingsLine Include="  &lt;RunConfiguration&gt;" />
      <_TestRunSettingsLine Include="    &lt;!-- Plugin scans use this folder. It is the live game bin, not the test output. --&gt;" />
      <_TestRunSettingsLine Include="    &lt;WorkingDirectory&gt;$(_TestGameBin)&lt;/WorkingDirectory&gt;" />
      <_TestRunSettingsLine Include="  &lt;/RunConfiguration&gt;" />
      <_TestRunSettingsLine Include="&lt;/RunSettings&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_TestRunSettingsPath)" Lines="@(_TestRunSettingsLine)" Overwrite="true" Encoding="UTF-8" />
  </Target>

