<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjectEternity</RootNamespace>
    <AssemblyName>Project Eternity</AssemblyName>
    <OutputType>WinExe</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>srweicon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <UseAppHost>true</UseAppHost>
    <!-- Content, Keys.ini, and the plugin folders live next to the exe. The project directory has none of them. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\</RunWorkingDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(AssemblyName).exe</StartProgram>
    <StartWorkingDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project Eternity Base Item\Project Eternity Base Item.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Constants\Project Eternity Constants.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Control Helper\Project Eternity Control Helper.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Game Screen\Project Eternity Game Screen.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Graphics\Project Eternity Graphics.csproj" />
    <ProjectReference Include="..\..\Core\Project Eternity Unit\Project Eternity Unit.csproj" />
    <ProjectReference Include="..\..\External\FMOD\FMOD.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Conquest Map\Project Eternity Conquest Map.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Life Sim\Project Eternity Life Sim.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Racing\Project Eternity Racing.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Sorcerer Street\Project Eternity Sorcerer Street.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity World Map\Project Eternity World Map.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Deathmatch Map AI\Project Eternity Deathmatch Map AI.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Deathmatch Map\Project Eternity Deathmatch Map.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Battle Map\Project Eternity Battle Map.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Super Tank\Project Eternity Super Tank.csproj" />
    <ProjectReference Include="..\..\Mods\Project Eternity Triple Thunder\Project Eternity Triple Thunder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FightScreen.cs" />
    <Compile Include="Game screens\Game Selection.cs" />
    <Compile Include="Game screens\Main Menu.cs" />
    <Compile Include="Game screens\Fanpresto Screen.cs" />
    <Compile Include="Game screens\Intro Menu.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Game.cs" />
    <Compile Include="Splash Screen.cs" />
    <Compile Include="Splash Screen.Designer.cs" DependentUpon="Splash Screen.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Splash Screen.resx" DependentUpon="Splash Screen.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Keys.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>

</Project>
